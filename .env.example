# =============================================================
# Contoh isi variabel lingkungan DuitKita
#
# LOKAL  : salin ke apps/web/.env dan apps/api/.env sesuai bagiannya
# VERCEL : masukkan SEMUA baris di bawah lewat
#          Project Settings > Environment Variables
#          (tanpa perlu membuat berkas .env di repo)
#
# JANGAN pernah meng-commit berkas .env yang berisi nilai asli.
# =============================================================

# ---------- apps/web/.env (dibaca browser, ikut terkirim ke pengguna) ----------
# Aman: kunci anon memang dirancang untuk publik dan dibatasi oleh aturan RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Kosongkan di Vercel supaya API dipanggil pada domain yang sama (/api/...).
# Isi http://localhost:4000 hanya untuk pengembangan di komputer sendiri.
VITE_API_URL=

# ---------- apps/api/.env (hanya di server, TIDAK boleh bocor) ----------
PORT=4000
# Beberapa alamat boleh dipisah koma. Di Vercel isi dengan domain produksimu.
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Dipakai untuk MEMERIKSA token pengguna. Sama dengan VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=eyJhbGciOi...

# RAHASIA BESAR. Melewati seluruh aturan keamanan basis data.
# Hanya untuk operasi admin (buat/hapus akun, monitor penyimpanan).
# Ambil di Supabase Dashboard > Project Settings > API Keys > service_role.
# Pastikan klaim di dalamnya berbunyi role=service_role dan ref=<kode proyekmu>;
# server akan menolak menyala bila bentuknya keliru.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Kunci Google Gemini. Yang kedua dipakai otomatis bila yang pertama kena limit.
GEMINI_API_KEY=AIza...
GEMINI_API_KEY_SECONDARY=

# Bisa diganti tanpa mengubah kode bila suatu saat model dipensiunkan Google.
GEMINI_MODEL=gemini-3.5-flash-lite
